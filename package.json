{
  "name": "witness",
  "version": "0.1.0",
  "private": true,
  "description": "Witness: AI agents spend on PayPal only what the human actually asked for.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run && node --test \"test/*.test.mjs\"",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "deps:check": "tsx scripts/check-architecture.ts",
    "check": "pnpm typecheck && pnpm deps:check && pnpm test",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx packages/db/src/migrate-cli.ts",
    "db:seed": "tsx scripts/seed.ts",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "spike:auth": "node spikes/01-auth.mjs",
    "spike:lifecycle": "node spikes/02-authorize-capture-void.mjs",
    "spike:vault": "node spikes/03-vault-authorize.mjs",
    "spike:swap": "node spikes/04-cart-swap.mjs",
    "spike:dispute": "node spikes/05-dispute.mjs",
    "eval": "tsx scripts/eval.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "eval:smoke": "tsx scripts/eval.ts --smoke",
    "eval:fake": "tsx scripts/eval.ts --fake",
    "postman:build": "tsx scripts/postman.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@witness/ai": "workspace:*",
    "@witness/api": "workspace:*",
    "@witness/catalog": "workspace:*",
    "@witness/config": "workspace:*",
    "@witness/core": "workspace:*",
    "@witness/db": "workspace:*",
    "@witness/engine": "workspace:*",
    "@witness/executor": "workspace:*",
    "@witness/paypal": "workspace:*",
    "drizzle-orm": "0.45.3",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
