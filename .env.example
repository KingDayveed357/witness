# Copy to .env and fill in. Never commit .env.
# Developer Dashboard > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox only. Witness refuses to run against any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Merchant ID of the sandbox Business account: the payee every order must pay (used by the seed script).
PAYPAL_MERCHANT_ID=

# Set after registering the webhook URL in the sandbox app (needs a public HTTPS URL, e.g. the Render deploy).
PAYPAL_WEBHOOK_ID=

# AI checks (Stage 4). Without it every AI check fails closed and purchases HOLD.
ANTHROPIC_API_KEY=
# Approved model only (see docs/ai-operations.md). Per-process limits: when hit, AI checks HOLD.
WITNESS_AI_MODEL=claude-haiku-5-5
WITNESS_AI_MAX_SPEND_USD=1
WITNESS_AI_MAX_CALLS=2000
WITNESS_AI_TIMEOUT_MS=30000
WITNESS_AI_MAX_RETRIES=2
# Separate spend cap for the public "try to beat it" screen (judge traffic), per process.
WITNESS_DEMO_AI_MAX_SPEND_USD=0.25

# Optional: live product facts. Without it Witness uses the labelled fixture catalog.
CHANNEL3_API_KEY=

# Local Postgres from `pnpm db:dev` (local-only credentials).
DATABASE_URL=postgres://witness:witness-dev-only@127.0.0.1:54330/witness

# Printed by `pnpm db:seed`; enables /v1/demo/scenarios.
WITNESS_DEMO_SHOPPER_ID=

# Used by the Phase 1 spikes only.
WITNESS_RETURN_URL=https://example.com/witness/return
WITNESS_CANCEL_URL=https://example.com/witness/cancel

# ---- web (apps/web) -----------------------------------------------------------------------
# The web app holds role keys server-side and proxies to the API; the browser never sees them.
# After `pnpm db:seed`, copy the ops, demo and shopper keys from .witness/dev-keys.json.
WITNESS_API_URL=http://127.0.0.1:4000
WITNESS_OPS_KEY=
WITNESS_DEMO_KEY=
WITNESS_SHOPPER_KEY=
# Console sign-in. Both required, or the console stays closed. Secret: at least 16 random chars.
WITNESS_CONSOLE_PASSWORD=
WITNESS_SESSION_SECRET=
# Optional: AG Studio licence (without it, Studio runs in trial mode with a watermark).
AG_STUDIO_LICENSE_KEY=
# Studio agent (Haiku via the web server): per-process spend cap.
WITNESS_STUDIO_AI_MAX_SPEND_USD=0.50
