# Copy to .env and fill in. Never commit .env.
# Developer Dashboard > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox only. The spikes refuse to run against any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Where PayPal sends the buyer after approval. The page does not need to exist:
# the spikes poll PayPal for the approval instead of waiting for the redirect.
WITNESS_RETURN_URL=https://example.com/witness/return
WITNESS_CANCEL_URL=https://example.com/witness/cancel
